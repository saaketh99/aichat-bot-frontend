# ─── LogiSync AI Frontend — Environment Variables ───────────────────────────
#
# This file is for LOCAL DEVELOPMENT only.
# In production (ECS), variables are passed via Docker build args.
#
# HOW IT WORKS:
#   - In dev:  Vite proxy forwards /api → VITE_API_BASE_URL (vite.config.js)
#   - In prod: Nginx proxy forwards /api → VITE_API_BASE_URL (nginx.conf)
#
# Vite rule: all variables MUST start with VITE_ to be accessible in browser.
# ─────────────────────────────────────────────────────────────────────────────

# Your ECS backend public IP and port
VITE_API_BASE_URL=http://3.108.54.170:3001
